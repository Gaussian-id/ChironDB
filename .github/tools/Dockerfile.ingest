# The same build profile as the product image, restricted to the benchmarked
# server so the control does not spend time linking unrelated CLI aliases.
FROM rust:1.92.0-bookworm@sha256:e90e846de4124376164ddfbaab4b0774c7bdeef5e738866295e5a90a34a307a2 AS build
ARG TARGETARCH
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends protobuf-compiler && rm -rf /var/lib/apt/lists/*
COPY . .
RUN --mount=type=cache,id=chirondb-cargo-registry-${TARGETARCH},target=/usr/local/cargo/registry \
    --mount=type=cache,id=chirondb-cargo-git-${TARGETARCH},target=/usr/local/cargo/git \
    --mount=type=cache,id=chirondb-target-${TARGETARCH},target=/app/target \
    cargo clean --release -p chirondb -p chirondb-core -p chirondb-types \
    && cargo build --release --locked -p chirondb --features jemalloc --bin chirondb --jobs 1 \
    && cp target/release/chirondb /app/chirondb

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241
ARG VCS_REF
LABEL org.opencontainers.image.revision="${VCS_REF}" org.chirondb.qualification="bulk-ingest"
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/chirondb /usr/local/bin/chirondb
ENTRYPOINT ["chirondb"]
