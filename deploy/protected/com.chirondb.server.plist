<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.chirondb.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/chirondb</string>
    <string>--config</string>
    <string>/usr/local/etc/chirondb/chirondb.toml</string>
    <string>--tenant-enforcement</string>
    <string>enforced</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ExitTimeOut</key>
  <integer>15</integer>
  <key>StandardOutPath</key>
  <string>/usr/local/var/log/chirondb.log</string>
  <key>StandardErrorPath</key>
  <string>/usr/local/var/log/chirondb-error.log</string>
</dict>
</plist>
